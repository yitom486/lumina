# Native player binaries (dev machine only; keep README + VERSION)
apps/desktop/src-tauri/native/mpv/*
!apps/desktop/src-tauri/native/mpv/README.md
!apps/desktop/src-tauri/native/mpv/VERSION
!apps/desktop/src-tauri/native/mpv/runtime/
apps/desktop/src-tauri/native/mpv/runtime/*
!apps/desktop/src-tauri/native/mpv/runtime/.gitkeep
# Native ffmpeg/ffprobe (dev machine only; keep README + VERSION)
apps/desktop/src-tauri/native/ffmpeg/*
!apps/desktop/src-tauri/native/ffmpeg/README.md
!apps/desktop/src-tauri/native/ffmpeg/VERSION
# Native whisper (optional, on-demand ASR; keep README only)
apps/desktop/src-tauri/native/whisper/*
!apps/desktop/src-tauri/native/whisper/README.md
!apps/desktop/src-tauri/native/whisper/VERSION
# Native yt-dlp (optional online source; keep README only)
apps/desktop/src-tauri/native/ytdl/*
!apps/desktop/src-tauri/native/ytdl/README.md

apps/desktop/src-tauri/native/acp/*
!apps/desktop/src-tauri/native/acp/README.md
