{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lumina/contracts": ["../../packages/contracts/src/index.ts"],
      "@lumina/contracts/*": ["../../packages/contracts/src/*"],
      "@lumina/query-keys": ["../../packages/query-keys/src/index.ts"],
      "@lumina/query-keys/*": ["../../packages/query-keys/src/*"],
      "@lumina/player-ui": ["../../packages/player-ui/src/index.ts"],
      "@lumina/player-ui/*": ["../../packages/player-ui/src/*"],
      "@lumina/chat-ui": ["../../packages/chat-ui/src/index.ts"],
      "@lumina/chat-ui/*": ["../../packages/chat-ui/src/*"],
      "@lumina/ui": ["../../packages/ui/src/index.ts"],
      "@lumina/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src",
    "../../packages/contracts/src",
    "../../packages/query-keys/src",
    "../../packages/player-ui/src",
    "../../packages/chat-ui/src",
    "../../packages/ui/src"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
