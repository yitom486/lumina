{
  "name": "lumina-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": ["apps/desktop", "packages/contracts", "packages/query-keys", "packages/player-ui", "packages/transcript-ui", "packages/chat-ui"],
  "scripts": {
    "dev": "cd apps/desktop && bun run dev",
    "build": "cd apps/desktop && bun run build",
    "preview": "cd apps/desktop && bun run preview",
    "typecheck": "cd apps/desktop && bun run typecheck",
    "lint": "cd apps/desktop && bun run lint",
    "lint:ox": "oxlint apps/desktop/src packages/contracts/src packages/query-keys/src packages/player-ui/src packages/chat-ui/src",
    "lint:all": "cd apps/desktop && bun run lint:all",
    "check:rust": "cargo fmt --all --check && cargo check --workspace --all-targets && cargo test --workspace --lib && cargo clippy --workspace --all-targets -- -D warnings",
    "test": "cd apps/desktop && bun run test",
    "test:e2e:online": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --lib public_youtube_resolves_and_reaches_mpv_demux_without_cookies -- --ignored --nocapture",
    "test:unit": "cd apps/desktop && bun run test:unit",
    "test:ui": "cd apps/desktop && bun run test:ui",
    "tauri": "cd apps/desktop && bun run tauri"
  }
}
